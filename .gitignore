.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Run artifacts. Reproducible from a run's own recorded provenance; stays
# out of git until promoted to a written finding. results/canonical/ is
# the one deliberate exception -- the immutable raw record every figure
# in docs/tiers.md traces back to, committed on purpose.
results/*
!results/.gitkeep
!results/canonical/

# Laundered handoff reports exchanged with Vedaksha's own team — working
# correspondence, not repo content. Substance that matters long-term goes
# into docs/tiers.md instead.
docs/findings/*
!docs/findings/.gitkeep

# Reference-engine kernels, exports and installations — software/data
# files, never committed.
vendor/
*.bsp
*.se1
hip_main.dat

# Session-bridge memory: internal working notes (names, governance/process
# detail, cross-repo mentions) — the same content class docs/findings/ and
# AGENTS.md's own "public-doc-style" rule keep out of tracked repo content.
# Local-only, same treatment as vedaksha's zero-footprint posture.
docs/memory/
